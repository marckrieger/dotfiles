#!/bin/bash

# Launch the passed in URL as a web app in the default browser (or chromium if the default doesn't support --app).
# Patched: when url-dispatcher is the default, detect the actual browser.

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
url-dispatcher*)
  for b in google-chrome.desktop brave-browser.desktop microsoft-edge.desktop chromium.desktop; do
    if ls {~/.local,~/.nix-profile,/usr}/share/applications/$b 2>/dev/null | head -1 | grep -q .; then
      browser="$b"; break
    fi
  done
  ;;
*) browser="chromium.desktop" ;;
esac

exec setsid uwsm-app -- $(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1) --app="$1" "${@:2}"
