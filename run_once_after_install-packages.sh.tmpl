#!/bin/bash
set -euo pipefail

PACKAGE_FILE="{{ .chezmoi.homeDir }}/.config/omarchy/packages.txt"
[[ ! -f "$PACKAGE_FILE" ]] && exit 0

MISSING=()
while IFS= read -r pkg; do
    pkg=$(echo "$pkg" | xargs)
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    pacman -Qi "$pkg" &>/dev/null || MISSING+=("$pkg")
done < "$PACKAGE_FILE"

[[ ${#MISSING[@]} -eq 0 ]] && exit 0

echo "📦 Installing ${#MISSING[@]} package(s): ${MISSING[*]}"
for pkg in "${MISSING[@]}"; do
    if pacman -Si "$pkg" &>/dev/null; then
        sudo pacman -S --noconfirm --quiet "$pkg" 2>/dev/null
    else
        omarchy-pkg-aur-add "$pkg" 2>/dev/null || echo "  ✗ $pkg"
    fi
done
