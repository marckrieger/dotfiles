#!/bin/bash
set -euo pipefail

THEME_FILE="{{ .chezmoi.homeDir }}/.config/omarchy/theme.txt"
[[ ! -f "$THEME_FILE" ]] && exit 0

DESIRED=$(cat "$THEME_FILE" | xargs)
CURRENT=$(omarchy-theme-current 2>/dev/null || echo "")

if [[ "$DESIRED" != "$CURRENT" ]]; then
    echo "🎨 Setting theme → $DESIRED"
    omarchy-theme-set "$DESIRED"
fi
